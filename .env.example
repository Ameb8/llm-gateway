# Provider Keys
MISTRAL_API_KEY=YOUR_MISTRAL_KEY
GEMINI_API_KEY=YOUR_GEMINI_KEY
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY


# LiteLLM Key
LITELLM_MASTER_KEY=super-secret-gateway-key


# Database Credentials
DB_USER=db_user
DB_PASSWORD=db_password
DB_NAME=litellm_db


# The Connection String LiteLLM uses internally
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://db_user:db_password@db:5432/litellm_db